# Oracle deployment environment — copy to .env and fill in values
# cp .env.example .env

# Postgres password (choose something strong)
POSTGRES_PASSWORD=change_me_strong_password

# Enrichment provider for Phase 1 alert pipeline.
# Option A — MiniMax (if you already have a key)
ENRICH_API_KEY=your_minimax_api_key_here
ENRICH_PROVIDER=minimax
ENRICH_MODEL=abab6.5s-chat
ENRICH_RATE_LIMIT_RPM=30

# Option B — Gemini free tier (15 RPM, get key at aistudio.google.com/apikey)
# ENRICH_API_KEY=your_gemini_api_key_here
# ENRICH_PROVIDER=gemini
# ENRICH_MODEL=gemini-2.0-flash
# ENRICH_RATE_LIMIT_RPM=15
